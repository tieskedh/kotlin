+// DOTNET_GENERIC_OWNER_STORAGE_CYCLE_PROBE
+// Experimental storage-cycle proof. Every scenario expects Kotlin-correct success;
+// the fixture-local ordinary C# observer reports failures independently.
+// MODULE: lib1
+// FILE: factories.kt
+package storage.cycle
+
+interface Producer<out T> {
+    fun produce(): T
+}
+
+class Box<T>(initial: T) {
+    private var value: T = initial
+
+    fun read(): T = value
+    fun write(value: T) { this.value = value }
+}
+
+fun <T> make(value: T): Box<T> = Box(value)
+fun <T> makeNested(value: Producer<T>): Box<Producer<T>> = Box(value)
+
+class IntProducer : Producer<Int> {
+    private var calls = 0
+    override fun produce(): Int { calls++; return 73 }
+    fun callCount(): Int = calls
+}
+
+class StringProducer(private val text: String) : Producer<String> {
+    private var calls = 0
+    override fun produce(): String { calls++; return text }
+    fun callCount(): Int = calls
+}
+
+class BottomProducer(private val failure: Throwable) : Producer<Nothing> {
+    private var calls = 0
+    override fun produce(): Nothing { calls++; throw failure }
+    fun callCount(): Int = calls
+}
+
+open class Animal
+class Cat : Animal()
+
+class CatProducer(private val cat: Cat) : Producer<Cat> {
+    private var calls = 0
+    override fun produce(): Cat { calls++; return cat }
+    fun callCount(): Int = calls
+}
+
+// MODULE: lib2(lib1)
+// FILE: writers.kt
+package storage.cycle
+
+fun makeInt(): Box<Int> = make(17)
+fun makeString(): Box<String> = make("scalar")
+
+fun makeExact(value: StringProducer): Box<Producer<String>> = make<Producer<String>>(value)
+
+fun makeBroad(value: IntProducer): Box<Producer<Any>> {
+    val widened: Producer<Any> = value
+    return make<Producer<Any>>(widened)
+}
+
+fun makeBottom(value: BottomProducer): Box<Producer<String>> {
+    val widened: Producer<String> = value
+    return make<Producer<String>>(widened)
+}
+
+fun makeReference(value: CatProducer): Box<Producer<Animal>> {
+    val widened: Producer<Animal> = value
+    return make<Producer<Animal>>(widened)
+}
+
+fun makeNestedBroad(value: IntProducer): Box<Producer<Any>> {
+    val widened: Producer<Any> = value
+    return makeNested<Any>(widened)
+}
+
+fun makeNestedBottom(value: BottomProducer): Box<Producer<String>> {
+    val widened: Producer<String> = value
+    return makeNested<String>(widened)
+}
+
+fun writeInt(box: Box<Int>) { box.write(29) }
+fun writeString(box: Box<String>) { box.write("replaced scalar") }
+fun writeExact(box: Box<Producer<String>>, value: StringProducer) { box.write(value) }
+
+fun writeBroad(box: Box<Producer<Any>>, value: IntProducer) {
+    val widened: Producer<Any> = value
+    box.write(widened)
+}
+
+fun writeBroadString(box: Box<Producer<Any>>, value: StringProducer) {
+    val widened: Producer<Any> = value
+    box.write(widened)
+}
+
+fun writeBottom(box: Box<Producer<String>>, value: BottomProducer) {
+    val widened: Producer<String> = value
+    box.write(widened)
+}
+
+fun writeReference(box: Box<Producer<Animal>>, value: CatProducer) {
+    val widened: Producer<Animal> = value
+    box.write(widened)
+}
+
+// MODULE: main(lib2)
+// FILE: main.kt
+package storage.cycle
+
+// The validator runs the independently reported C# scenarios after both library
+// DLLs have been compiled. It never treats a caught storage failure as success.
+fun box(): String = "OK"
